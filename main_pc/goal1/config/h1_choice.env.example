# h1_choice.env - run settings of real_run.sh --human and rp5_human_up.sh (read as KEY=VALUE text, never executed).
# Copy to goal1/config/h1_choice.env (another place: H1_CHOICE=<file>). Paths are relative to the effmass-mpc root.
# Settings of the 2026-11-24 runs:
MPS=1
PROFILE=goal1/config/real_slowc_i3.yml
MPC_EXTRA="--hsel topk --hsel-k 3 --hsel-every new --human-jump-filter 1 --hjf-mode anchor --human-vel-clean 1 --human-d-base 0.10 --human-field 1 --hf-wt 100 --infeas-escape 1 --human-base-exclude goal1/config/base_exclude.yaml --human-shoulder 1 --rec-plan 1 --human-robot-exclude link0,link1"
SKIP_LATE=1
SENSING_MPS_THREADS=50
SENSING_BASE_EXCLUDE=goal1/config/base_exclude.yaml
HUMAN_CHEST_SPINE3=1
MASS_MODE=human
