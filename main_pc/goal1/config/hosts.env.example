# hosts.env - copy to goal1/config/hosts.env (not committed) and fill in. Sourced by goal1/scripts/real_run.sh and
# goal1/real_prep5/rp5_human_up.sh (another place: EFFMASS_HOSTS=<file>).
# Control PC login for ssh (user@address), reached over the wired LAN; it must have the tmux session "franka" (real_run.sh).
CONTROL_PC=CONTROL_PC_USER@CONTROL_PC_HOST
# Fast DDS profile of the main PC side of the link (copy of goal1/config/fastdds_main_pc.xml.example with the addresses filled in).
FASTDDS_MAIN_PC_XML=
# Human perception (hrc_ws, private repository, not included): command that starts it with one argument <out_dir> and writes
# <out_dir>/sensing_perf/*.csv (one line per frame), and a text that identifies its python process command line.
HUMAN_PERCEPTION_START=
HUMAN_PERCEPTION_START_BODIES=
HUMAN_PERCEPTION_PROC=
# Location of the perception workspace (its message package is put on the ROS paths of the MPC python and the human node).
HRC_WS=
